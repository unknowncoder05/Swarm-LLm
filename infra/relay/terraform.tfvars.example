# Copy to terraform.tfvars (ignored) and replace placeholders. Keep it private.
hosted_zone_name    = "example.com"
dns_name            = "relay.example.com"
agent_key           = "<existing PeerFoundry AGENT_KEY>"
allowed_https_cidrs = ["<worker network public IPv4>/32", "<coordinator public IPv4>/32"]
instance_type       = "t4g.micro"
max_runtime_hours   = 4
