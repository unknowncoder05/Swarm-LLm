{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rpc_transport",
    "rpc_agent_ids"
  ],
  "properties": {
    "rpc_transport": {
      "enum": [
        "quic",
        "auto"
      ]
    },
    "rpc_agent_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
