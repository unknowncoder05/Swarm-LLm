{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "messages"
  ],
  "properties": {
    "model": {
      "type": "string",
      "pattern": "\\S"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool",
              "function"
            ]
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "tool_calls": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "function"
                  ],
                  "properties": {
                    "function": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "think": {
          "type": ["boolean", "string", "null"]
        },
        "num_predict": {
          "type": "integer",
          "anyOf": [
            {
              "const": -1
            },
            {
              "minimum": 1,
              "maximum": 65536
            }
          ]
        }
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "stream": {
      "type": "boolean"
    },
    "think": {
      "type": ["boolean", "string", "null"]
    },
    "stream_options": {
      "type": "object"
    },
    "tools": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "function"
            ],
            "properties": {
              "function": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
