{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "maxItems": 16,
  "items": {
    "type": "object",
    "required": [
      "id",
      "url",
      "control_key"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "control_key": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "enum": [
          "local",
          "cloud"
        ]
      },
      "agent_ids": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
