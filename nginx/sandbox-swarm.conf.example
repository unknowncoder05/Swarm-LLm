# Include these locations inside the HTTPS server for sandbox.yerson.co.
    # Swarm controller: dashboard, API, and agent downloads.
    location = /swarm {
        return 308 /swarm/;
    }

    location ^~ /swarm/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3660s;  # includes cold model loading over the HTTPS relay
        proxy_buffering off;
    }

