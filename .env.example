# Copy to .env and fill in. Run `make init` to auto-generate all three keys.
# Never commit .env to git.

# Full access: dashboard, /machines, /stats, and all endpoints below
ADMIN_KEY=replace_with_admin_secret

# Agent authentication: registration, heartbeats, claims, RPC and reports
AGENT_KEY=replace_with_agent_secret

# API consumers (IDE, Continue.dev, curl): /v1/chat/completions and /v1/models
CONSUMER_KEY=replace_with_consumer_secret

# Optional deployment URL for clients; keep the actual value in ignored .env files.
PEERFOUNDRY_BASE_URL=http://127.0.0.1:8081/peerfoundry/api/v1
# Optional explicit download URL for deployments without mounted agent sources.
AGENT_SOURCE_URL=

# Hold an idle native model between coding requests (60..3600 seconds).
# 900 avoids repeated loading during a session; the GPUs remain reserved.
RPC_IDLE_TIMEOUT_SEC=900
# Optional private host-local Terraform lifecycle service. Never expose publicly.
RPC_RELAY_PROVISIONER_URL=
RPC_RELAY_PROVISIONER_KEY=
# Prefer verified LAN QUIC, configured relays, then the coordinator relay.
RPC_DEFAULT_TRANSPORT=auto
# Optional JSON map of measured model-specific profiles; empty retains native defaults.
RPC_MODEL_RUNTIME_PROFILES=
# Cloud relay creation/use is opt-in. Local relay candidates remain independent.
RPC_CLOUD_RELAY_ENABLED=false
# Private JSON array: [{"id":"network-a","url":"https://...","control_key":"...","scope":"local","agent_ids":[...]}]
RPC_RELAYS=[]
