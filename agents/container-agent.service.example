[Unit]
Description=PeerFoundry container worker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/peerfoundry-container-agent.env
ExecStart=/usr/bin/python3 /opt/peerfoundry/container_agent.py --coordinator https://peerfoundry.example.com/peerfoundry/api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
