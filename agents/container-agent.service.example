[Unit]
Description=Swarm LLM container worker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/swarm-container-agent.env
ExecStart=/usr/bin/python3 /opt/swarm-llm/container_agent.py --coordinator https://swarm.example.com/swarm/api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
